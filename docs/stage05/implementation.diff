+async function submit(o){content.replaceChildren(node('h1','Передать заказ на обработку'),node('p','Проверьте комментарий. Передача сохраняет текущую редакцию и направляет её менеджеру для проверки.'));const f=node('form'),label=node('label','Комментарий менеджеру'),text=node('textarea');text.name='comment';text.maxLength=2000;text.required=o.preparation_mode==='manager_assisted';if(text.required)text.minLength=10;label.append(text);f.append(label);let check=null;if(['invalid','needs_confirmation','incomplete'].includes(o.calculation_state)){const l=node('label','Передать позиции, требующие уточнения, на проверку менеджеру');check=node('input');check.type='checkbox';l.append(check);f.append(l);}f.append(node('button','Подтвердить отправку'));const key=crypto.randomUUID();f.onsubmit=e=>{e.preventDefault();run(async()=>{const body={comment:text.value,handoff_problematic:check?.checked||false};if(o.revision_id)body.revision_id=o.revision_id;if(o.calculation_id)body.preliminary_calculation_id=o.calculation_id;await api('/orders/'+o.order_id+'/submit','POST',body,{'If-Match':String(o.optimistic_lock_version),'Idempotency-Key':key});await detail(o.order_id);message('Заказ передан на обработку.');});};content.append(f,button('Назад к заказу',()=>detail(o.order_id),true));}
