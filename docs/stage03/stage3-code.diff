+ version integer NOT NULL, resolution jsonb NOT NULL, created_by uuid NOT NULL REFERENCES mf_users,
+ created_at timestamptz NOT NULL DEFAULT now(), UNIQUE(row_id,version)
+);
+CREATE TABLE mf_order_draft_rows (
