# Template only. Generate fresh values in staging. Never copy production variables.
MF_ENVIRONMENT=staging
MF_DATABASE_URL=postgresql://mf_staging_app:REPLACE_WITH_NEW_SECRET@DEDICATED_STAGING_HOST:5432/mf_staging
MF_DATABASE_HOST=DEDICATED_STAGING_HOST
MF_DATABASE_NAME=mf_staging
MF_PRIVATE_STORAGE_ROOT=/mf-private/files
MF_JOB_NAMESPACE=mf.staging.v2
MF_AGENT_TRANSPORT=disabled
MF_OUTBOX_DISPATCH=disabled
MF_EXPECTED_RAILWAY_PROJECT_ID=NEW_STAGING_PROJECT_ID
MF_EXPECTED_RAILWAY_ENVIRONMENT_ID=NEW_STAGING_ENVIRONMENT_ID
# Railway supplies RAILWAY_VOLUME_MOUNT_PATH=/mf-private after volume attachment.
# No AGENT_API_KEY at all in Stage 1; no consumer endpoint exists to accept it.
# Generate dedicated Agent credentials only when a fake consumer actually needs them.
